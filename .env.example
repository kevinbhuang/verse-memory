# --------------------------------------------------------------------------
# Verse Memory environment variables
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored. Never commit real tokens.

# Server-side only. Used by:
#   - `npm run verify:esv` (Node script)
#   - Netlify function `esv-audio` / Vite dev proxy for Listen controls
# It is intentionally NOT prefixed with VITE_ so Vite cannot inline it
# into client bundles. Set the same variable in the Netlify UI for production.
ESV_API_TOKEN=

# ---- Public, client-safe configuration (optional overrides) ----
# These are inlined into the browser bundle, so they must never hold secrets.

# Display name of the application.
VITE_APP_NAME=Verse Memory

# Title of the passage collection shown throughout the UI.
VITE_COLLECTION_TITLE=100 Verses Every Christian Should Know

# Subtitle shown beneath the collection title.
VITE_COLLECTION_SUBTITLE=171-Passage Collection

# Translation attribution shown in the footer and About section.
VITE_TRANSLATION_ATTRIBUTION=Scripture quotations are from the ESV® Bible (The Holy Bible, English Standard Version®), copyright © 2001 by Crossway, a publishing ministry of Good News Publishers. Used by permission. All rights reserved.
